# 이 파일을 .env로 복사해서 값을 채운다. .env는 절대 커밋하지 않는다 (.gitignore에 있음).

# 유튜브 영상 카테고리 조회 (window_tracker, YouTube Data API v3 키)
YOUTUBE_API_KEY=

# LLM 창 분류·리포트 문구 (scoring, config/llm.py). 키가 없으면 LLM 없이 동작한다.
# 연결 확인: python -m scoring.llm_client --check
LLM_PROVIDER=gemini
# Gemini 무료 티어 키: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 비교용 Groq 무료 플랜 키: https://console.groq.com/keys  (LLM_PROVIDER=groq로 바꿔 사용)
GROQ_API_KEY=
# 모델을 바꿀 때만 (비우면 config/llm.py의 기본 모델). 목록: python -m scoring.llm_client --list-models
LLM_MODEL=
